[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/neon/neon_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://ui/settings.gd" id="4_page"]
[ext_resource type="Script" path="res://ui/neon/neon_dot_slider.gd" id="5_slider"]
[ext_resource type="Script" path="res://ui/neon/neon_checkbox.gd" id="6_check"]
[ext_resource type="Script" path="res://ui/neon/neon_title.gd" id="nt_title"]

[node name="Settings" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("1_theme")
script = ExtResource("4_page")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 28

[node name="Stack" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Head" type="VBoxContainer" parent="Margin/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Kicker" type="Label" parent="Margin/Stack/Head"]
layout_mode = 2
theme_type_variation = &"Kicker"
text = "Settings"
uppercase = true

[node name="Title" type="Label" parent="Margin/Stack/Head"]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"TitleLabel"
theme_override_constants/shadow_offset_x = 4
theme_override_constants/shadow_offset_y = 4
theme_override_font_sizes/font_size = 52
text = " Animals "
script = ExtResource("nt_title")
title = "Animals"

[node name="HeadGap" type="Control" parent="Margin/Stack"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
mouse_filter = 2

[node name="Form" type="VBoxContainer" parent="Margin/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 28

[node name="MovementField" type="VBoxContainer" parent="Margin/Stack/Form"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Row" type="HBoxContainer" parent="Margin/Stack/Form/MovementField"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="Label" type="Label" parent="Margin/Stack/Form/MovementField/Row"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_type_variation = &"FactLabel"
text = "Movement"
vertical_alignment = 1
uppercase = true

[node name="Movement" type="Control" parent="Margin/Stack/Form/MovementField/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
size_flags_vertical = 4
focus_neighbor_bottom = NodePath("../../../SubpixelField/Row/Subpixel")
script = ExtResource("5_slider")
stops = PackedStringArray("Smooth", "Stepped")
index = 0

[node name="Note" type="MarginContainer" parent="Margin/Stack/Form/MovementField"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 224
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 0

[node name="MovementNote" type="Label" parent="Margin/Stack/Form/MovementField/Note"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"SmallTextLabel"
text = "Smooth: they glide between ticks. Stepped: they hop a voxel at a time and turn in steps, like the old stamped animals."
autowrap_mode = 3

[node name="SubpixelField" type="VBoxContainer" parent="Margin/Stack/Form"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Row" type="HBoxContainer" parent="Margin/Stack/Form/SubpixelField"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="Label" type="Label" parent="Margin/Stack/Form/SubpixelField/Row"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_type_variation = &"FactLabel"
text = "Subpixel"
vertical_alignment = 1
uppercase = true

[node name="Subpixel" type="BaseButton" parent="Margin/Stack/Form/SubpixelField/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_neighbor_top = NodePath("../../../MovementField/Row/Movement")
toggle_mode = true
button_pressed = true
script = ExtResource("6_check")

[node name="Note" type="MarginContainer" parent="Margin/Stack/Form/SubpixelField"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 224
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 0

[node name="SubpixelNote" type="Label" parent="Margin/Stack/Form/SubpixelField/Note"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"SmallTextLabel"
text = "Smooth movement only. On, they glide between pixels; off, they land on whole pixels."
autowrap_mode = 3

