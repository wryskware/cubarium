[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/neon/neon_theme.tres" id="1_theme"]
[ext_resource type="Texture2D" path="res://ui/neon/art/world.png" id="2_world"]
[ext_resource type="Material" path="res://ui/neon/neon_scrim.tres" id="3_scrim"]
[ext_resource type="Script" path="res://ui/neon/neon_button.gd" id="4_button"]
[ext_resource type="Script" path="res://ui/neon/neon_label.gd" id="5_label"]
[ext_resource type="Script" path="res://ui/pause_menu.gd" id="6_menu"]
[ext_resource type="Script" path="res://ui/neon/neon_title.gd" id="nt_title"]

[node name="PauseMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("1_theme")
script = ExtResource("6_menu")

[node name="World" type="TextureRect" parent="."]
texture_filter = 1
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("2_world")
expand_mode = 1
stretch_mode = 6

[node name="Scrim" type="ColorRect" parent="."]
material = ExtResource("3_scrim")
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Page" type="Control" parent="Center"]
custom_minimum_size = Vector2(1920, 1080)
layout_mode = 2
mouse_filter = 2

[node name="Body" type="PanelContainer" parent="Center/Page"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -286.0
offset_top = -390.0
offset_right = 286.0
offset_bottom = 390.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"MainPanel"

[node name="Margin" type="MarginContainer" parent="Center/Page/Body"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 56

[node name="Stack" type="VBoxContainer" parent="Center/Page/Body/Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Center/Page/Body/Margin/Stack"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = " Paused "
script = ExtResource("nt_title")
title = "Paused"
vertical_alignment = 1

[node name="Gap1" type="Control" parent="Center/Page/Body/Margin/Stack"]
