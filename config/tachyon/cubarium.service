[Unit]
Description=Cubarium — the living ring world on the Tachyon panel
Documentation=file:/usr/local/share/doc/cubarium/tachyon.md
# The daemon owns KMS and hands out the frame socket; we are only its client.
# `Wants=`, not `Requires=`: if the daemon is restarted under us the client dies,
# `Restart=always` brings us back, and `connect_when_free` waits 4 s for the socket.
After=cube-screen-shim.service network.target
Wants=cube-screen-shim.service

[Service]
Type=simple
User=cubarium
Group=cubarium
# `video` is the frame socket's group (srw-rw---- root:video) and the connector
# probe; `render` is /dev/dri/renderD128, which the Vulkan loader opens. Without
# `render` the failure is `vkCreateInstance: A host memory allocation has failed`
# and says nothing about permissions (led-cube-shim GS-2b).
SupplementaryGroups=video render
WorkingDirectory=/var/lib/cubarium
Environment=RUST_LOG=info
# The look, decided by Wrysk on 2026-09-16 after seeing both on the panel: 32-pixel
# plants. `--gpu-art-scale 2` draws one authored source texel on a `2S x 2S` block
# instead of an `S x S` one, so a 16 px tile is 64 raster pixels at this rung; on a
# 5.5-inch panel it is visibly the better picture. GS-1c made it hold 60 fps
# (59.9 over 60 s; it was 42.7 when the decision was taken). `--gpu-bend-substep`
# is NOT here because it is already the default on a ring at S >= 2.
#
# **Both quotes matter, and in opposite directions.** `Environment=` splits its own
# line on whitespace into separate assignments, so an unquoted
# `Environment=CUBARIUM_EXTRA_ARGS=--gpu-art-scale 2` sets the variable to
# `--gpu-art-scale` and throws the `2` away — the service then crash-loops with
# "a value is required for '--gpu-art-scale'". The assignment is quoted here so it
# is one value. `$CUBARIUM_EXTRA_ARGS` in the ExecStart below is *not* quoted,
# because there systemd splits an unquoted variable on whitespace into separate
# arguments, which is what turns the one value back into two. An empty one expands
# to no arguments at all. (W2 recorded the second half of this rule and not the
# first; GS-1c hit the first.)
#
# `--gpu-web-rate 2` also belongs here rather than in the ExecStart below; see the
# note on it.
Environment="CUBARIUM_EXTRA_ARGS=--gpu-web-rate 2"
# Every core but one: the board runs nothing else (Wrysk, 2026-09-22). The old
# 4-7 mask met core_ctl offlining idle big cores and left the sim two threads;
# the tick's default thread count is now whatever it can see minus one.
CPUAffinity=0-6

# `cubarium voxel`: a 160x48x24 voxel world presented through the GPU cutaway
# renderer straight into scanout dma-bufs for cube-screen-shim.
# 640x360 raster rotated 90 degrees with 3x upscale fills the 1080x1920 panel exactly.
#
# `--gpu-web-rate 2` serves the GPU raster to http://127.0.0.1:7393/ twice a second;
# reach it via `ssh -N -L 7393:127.0.0.1:7393 root@192.168.68.68`.
ExecStart=/usr/local/bin/cubarium voxel \
    --config /var/lib/cubarium/voxel.toml \
    --state /var/lib/cubarium/state \
    --sink gpu \
    --gpu-target shim \
    --fps 60 \
    $CUBARIUM_EXTRA_ARGS

# `ctrlc` is built without its `termination` feature, so the clean-stop flag is
# raised by SIGINT and by nothing else. SIGTERM would kill the process between
# checkpoints and throw away up to capacity.checkpoint_seconds (60 s) of world;
# SIGINT makes `systemctl stop|restart` and a reboot each end in a final
# snapshot at the exact tick the world stopped on.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
