# voidrunner: Legion Go (Ryzen Z2 Extreme), the terrarium in a window on its own
# screen, as wrysk's user service. Read by scripts/deploy.sh (on the development host)
# and scripts/run-live.sh (on voidrunner).

SSH=${VOIDRUNNER:-voidrunner}
# The checkout on the host, relative to the remote home.
REMOTE=cubarium
SCOPE=user
UNIT=cubarium.service
UNIT_FILE=config/voidrunner/cubarium.service

# The Z2 Extreme has two L3 groups: 3 Zen 5 cores at 5.1 GHz (CPUs 0-2, 8-10) and
# 5 Zen 5c cores at 3.3 GHz (3-7, 11-15). Run on the Zen 5 group. Measured 2026-09-25 on the
# terrarium: step 10.3 ms/tick and 60 of 60 fps presented there, against 20.4 ms/tick and
# 50 fps on the Zen 5c group (which the program's own one-chiplet rule picks, being
# the group with more CPUs).
RUN_CPUS=0-2,8-10
RUN_ARGS="voxel --config config/voidrunner/terrarium.toml --sink gpu --gpu-target window --fps 60 --textures"
STATE=$HOME/cubarium-state
