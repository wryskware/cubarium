# The Tachyon panel board: a system service run as the `cubarium` user, installed by
# scripts/tachyon-install.sh with its own unit (config/tachyon/cubarium.service, which
# keeps its CPUAffinity and in-program --pin-loop placement). Read by scripts/deploy.sh.
#
# Use the IP: `tachyon-8968c731.local` resolves to a link-local IPv6 address that ssh
# refuses.

SSH=${TACHYON:-root@192.168.68.68}
REMOTE=/root/cubarium-deploy
SCOPE=system
UNIT=cubarium.service
INSTALL=scripts/tachyon-install.sh

# The board's DNS is dead, so cargo runs offline from a registry synced from here.
OFFLINE=yes
SYNC_REGISTRY=yes
# Stop the service before compiling: it and the build compete for the same cores.
STOP_BEFORE_BUILD=yes
# Never a single core: core_ctl isolates idle big cores, and a one-core mask is both a
# slow build and a misleading one. The first build in an empty target is cold (tens of
# minutes); seed it from an earlier tree built with the same toolchain:
#     ssh $SSH 'cp -a /root/cubarium-gs1/target /root/cubarium-deploy/target'
BUILD_CPUS=4-7
