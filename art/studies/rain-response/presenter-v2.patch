+// --- Rain response (study prototype, art/studies/rain-response) ------------------------
+//
+// A plant standing in rain quivers: falling drops knock its stalk and leaves sideways a
+// fraction of a pixel, irregularly, and the quiver dies away when the rain stops. This is
+// a *presentation* of the world's published per-cell rain rate (`RenderView::rain`, what
+// actually falls this tick, natural weather and an applied shower alike), never of a
+// requested dose, and it changes no field, no growth pacing and no creature. It rides the
+// same rooted horizontal `Bend` the breeze uses, so the root row stays bit-identical,
+// joins hold, and the family's measured nine-pixel headroom bounds wind and rain together.
+
+/// Per-family desired rain quiver at full rain, in tile pixels of tip travel. Families not
+/// listed do not answer rain. Small plants only: the two canopy species turn rather than
+/// bend and tall columns are excluded so a vine can never slide against its trunk;
+/// `rootveil` is a crust and stays still; `tendrilfan`'s own art leaves no headroom beyond
+/// its wind (0.31 px budget), so it is not listed — listing it would be a request
+/// `rain_tip` clamps to 0. Revision 2 of the study: the first candidate (side stalks at
+/// ~0.5 px, `glowcap` still, full level at 0.2 d/s) changed at most one pixel by 1/255 at
+/// the care contract's own targets, which all lie in the soil band where `glowcap` and
+/// `rootveil` grow; the cap now answers too (2.4 px measured headroom) and the stalks ask
+/// for most of a pixel, still under a third of their measured budgets with the wind.
+pub const RAIN_RESPONSE: [(&str, f64); 3] =
+    [("lanternstalk", 0.9), ("reedspire", 0.9), ("glowcap", 0.7)];
+
+/// The published rain rate (d/s) at and above which a slot's quiver is at full level.
+/// Measured on the recorded openings: a Standard shower peaks at 0.235 d/s on its centre
+/// cell, 0.118 one hop out and 0.078 two hops out; natural showers peak at 0.06–0.09 d/s
+/// over minutes. 0.1 puts the whole applied patch near full at the shower's peak and lets
+/// a natural drizzle reach it only at its own peak.
+pub const RAIN_RESPONSE_RATE: f64 = 0.1;
+/// Seconds for the quiver level to rise toward its target once rain arrives (first-order),
+/// and to fall once it stops: quick to answer, slow to settle, never a cut.
+pub const RAIN_ATTACK_SECONDS: f64 = 0.3;
+pub const RAIN_RELEASE_SECONDS: f64 = 0.8;
+/// Below this level, with no rain, the level is exactly 0, so a settled slot takes the
+/// renderer's identity path and its image is the windless one bit for bit.
+pub const RAIN_SETTLE_FLOOR: f32 = 0.02;
+/// The two non-harmonic patter frequencies (Hz) and their weights: an irregular quiver
+/// rather than a metronome, with a per-slot phase so a patch does not move as one object.
+pub const RAIN_PATTER_HZ: [f64; 2] = [2.7, 4.3];
+pub const RAIN_PATTER_WEIGHT: [f64; 2] = [0.62, 0.38];
+
+/// The rain quiver a family asks for, in tile pixels; 0 for a family that does not answer.
+pub fn rain_response(name: &str) -> f64 {
+    RAIN_RESPONSE.iter().find(|(n, _)| *n == name).map_or(0.0, |(_, px)| *px)
+}
+
+/// The rain tip a family is admitted, so that wind and rain together never exceed the
+/// family's measured budget for the windiest slot: `min(desired, budget / (1 +
+/// WIND_SLOT_VARIATION) − effective wind tip)`, never negative.
+pub fn rain_tip(name: &str, budget: f64) -> f64 {
+    let desired = rain_response(name);
+    if desired <= 0.0 {
+        return 0.0;
+    }
+    let room = budget / (1.0 + WIND_SLOT_VARIATION) - effective_tip(wind_response(name).tip_px, budget);
+    desired.min(room).max(0.0)
+}
+
+/// The quiver level a published rain rate asks for: `clamp(rate / RAIN_RESPONSE_RATE, 0, 1)`;
+/// a non-finite or negative rate is 0.
+pub fn rain_level_target(rate: f32) -> f32 {
+    if !(rate.is_finite() && rate > 0.0) {
+        return 0.0;
+    }
+    (f64::from(rate) / RAIN_RESPONSE_RATE).min(1.0) as f32
+}
+
+/// One observed tick of a slot's quiver level: first-order toward `target` with
+/// [`RAIN_ATTACK_SECONDS`] when rising and [`RAIN_RELEASE_SECONDS`] when falling over `dt`
+/// seconds, and exactly 0 once no rain falls and the level is under [`RAIN_SETTLE_FLOOR`].
+/// No time (`dt` ≤ 0: a held or repeated observation) moves nothing, so a duplicate
+/// observation is idempotent; a non-positive time constant is an immediate snap.
+pub fn advance_rain_level(level: f32, target: f32, dt: f64) -> f32 {
+    let tau = if target > level { RAIN_ATTACK_SECONDS } else { RAIN_RELEASE_SECONDS };
+    let k = if !(dt > 0.0) {
+        0.0
+    } else if tau > 0.0 {
+        1.0 - (-dt / tau).exp()
+    } else {
+        1.0
+    };
+    let next = level + (target - level) * k as f32;
+    if target <= 0.0 && next < RAIN_SETTLE_FLOOR { 0.0 } else { next.clamp(0.0, 1.0) }
+}
+
+/// The irregular patter, in `[−1, 1]`, at presentation `seconds` for a slot whose phase is
+/// `phase` (radians): the two weighted sines of [`RAIN_PATTER_HZ`]. A pure function of time,
+/// so a frame is repeatable at any cadence and nothing drifts between frames.
+pub fn rain_patter(seconds: f64, phase: f64) -> f64 {
+    let t = std::f64::consts::TAU * seconds;
+    RAIN_PATTER_WEIGHT[0] * (RAIN_PATTER_HZ[0] * t + phase).sin()
+        + RAIN_PATTER_WEIGHT[1] * (RAIN_PATTER_HZ[1] * t + 2.1 * phase + 0.7).sin()
+}
+
+/// A slot's patter phase: hashed from its cell like the sway phase, in `[0, 2π)`.
+pub fn rain_phase_of(slot: &Slot) -> f64 {
+    plant_phase_of(cubarium_surface::cell_of(&slot.at), std::f64::consts::TAU)
+}
+
+/// [`slot_wind`] with the rain quiver added: at quiver `level` in `[0, 1]` a side-face
+/// plant's bend amplitude gains `rain_tip · slot.wind · level · rain_patter(seconds,
+/// phase)`, on the same rooted shape; a radial top-face plant and a family with no rain
+/// response are exactly [`slot_wind`]. At level 0 this is [`slot_wind`] bit for bit.
+pub fn slot_wind_rain(slot: &Slot, name: &str, budget: f64, seconds: f64, level: f32) -> (Bend, Vec2) {
+    let (bend, heading) = slot_wind(slot, name, budget, seconds);
+    if !(level > 0.0) {
+        return (bend, heading);
+    }
+    let tip = rain_tip(name, budget);
+    if tip <= 0.0 || (slot.at.face == Face::Top && wind_response(name).spin_deg > 0.0) {
+        return (bend, heading);
+    }
+    let quiver = tip * slot.wind * f64::from(level) * rain_patter(seconds, rain_phase_of(slot));
+    let shaped = if bend.length > 0.0 { bend } else { plant_bend(0.0, Vec2::ZERO, heading) };
+    (Bend { amplitude: shaped.amplitude + quiver, ..shaped }, heading)
+}
