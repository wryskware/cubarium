+
+/// Benchmark instrumentation (throwaway `bench/ash` and `bench/wgpu` branches only; never
+/// merged). With `CUBARIUM_BENCH_FRAMES=<path>` set, every rendered frame's CPU wall time
+/// around `target.draw` and its GPU times are kept in memory and written as CSV at
+/// `finish`. Unset, it costs one cached environment lookup per frame.
+mod bench_frames {
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    struct Log {
+        path: std::path::PathBuf,
+        rows: Vec<(f64, f64, f64, bool, [f64; 5])>,
+    }
+
+    static LOG: OnceLock<Option<Mutex<Log>>> = OnceLock::new();
+
+    fn log() -> Option<&'static Mutex<Log>> {
+        LOG.get_or_init(|| {
+            std::env::var_os("CUBARIUM_BENCH_FRAMES").map(|p| {
+                Mutex::new(Log { path: p.into(), rows: Vec::with_capacity(1 << 16) })
+            })
+        })
+        .as_ref()
+    }
+
+    pub fn armed() -> bool {
+        log().is_some()
+    }
+
+    /// One frame: CPU wall ms of the draw call, total GPU ms, whether the world pass
+    /// redrew, and the GPU splits (upload, slab walk, present, walk, plants) it added.
+    pub fn record(wall_ms: f64, gpu_ms: f64, redrew: bool, split: [f64; 5]) {
+        let Some(log) = log() else { return };
+        let end = SystemTime::now().duration_since(UNIX_EPOCH).map_or(0.0, |d| d.as_secs_f64());
+        let mut log = log.lock().unwrap_or_else(|e| e.into_inner());
+        log.rows.push((end, wall_ms, gpu_ms, redrew, split));
+    }
+
+    /// Write every frame recorded so far, once.
+    pub fn dump() {
+        let Some(log) = log() else { return };
+        let mut log = log.lock().unwrap_or_else(|e| e.into_inner());
+        let rows = std::mem::take(&mut log.rows);
+        let write = || -> std::io::Result<()> {
+            let mut f = std::io::BufWriter::new(std::fs::File::create(&log.path)?);
+            writeln!(f, "end_unix_s,draw_wall_ms,gpu_ms,redrew,upload_ms,slab_walk_ms,present_ms,walk_ms,plant_ms")?;
+            for (end, wall, gpu, redrew, s) in &rows {
+                writeln!(
+                    f,
+                    "{end:.6},{wall:.4},{gpu:.4},{},{:.4},{:.4},{:.4},{:.4},{:.4}",
+                    u8::from(*redrew),
+                    s[0],
+                    s[1],
+                    s[2],
+                    s[3],
+                    s[4]
+                )?;
+            }
+            f.flush()
+        };
+        if let Err(e) = write() {
+            eprintln!("cubarium voxel: bench frame log {}: {e}", log.path.display());
+        } else {
+            eprintln!("cubarium voxel: bench frame log: {} frames to {}", rows.len(), log.path.display());
+        }
+    }
+}
